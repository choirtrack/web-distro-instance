# Ignore everything but the "sites" folder ( for non core developer )

# don't ignore .htaccess or robots.txt
# from experience with some clients, these may need to be customised and therefore version controlled
#site/docroot/.htaccess
#site/docroot/robots.txt

# Ignore core and vendor when managing dependencies with Composer.
docroot/core
vendor

docroot/.csslintrc
docroot/.editorconfig
docroot/.eslintignore
docroot/.eslintrc.json
docroot/.gitattributes
docroot/.ht.router.php

docroot/autoload.php
docroot/core
docroot/index.php
# mustn't ignore libraries - js libraries will be lost and missing errors will appear on admin/reports/status
#docroot/libraries
docroot/modules/contrib
docroot/profiles
docroot/themes/contrib
docroot/update.php
docroot/web.config

# Ignore configuration files that may contain sensitive information.
# Ignore SimpleTest multi-site environment.
# And Ignore paths that contain generated content.
docroot/sites

# Vagrant/puphpet/VM files not to be tracked
vmconfig/puphpet/files/dot/ssh/*

# Non-drupal and platform development (IDE) artifacts

### OSX template
**/.DS_Store
**/.AppleDouble
**/.LSOverride

# Icon must end with two \r
**/Icon

# Thumbnails
**/._*

# Files that might appear in the root of a volume
**/.DocumentRevisions-V100
**/.fseventsd
**/.Spotlight-V100
**/.TemporaryItems
**/.Trashes
**/.VolumeIcon.icns
**/.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
**/.AppleDB
**/.AppleDesktop
**/Network Trash Folder
**/Temporary Items
**/.apdisk
